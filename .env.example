# Google OAuth for the Google Drive account that stores Devkansh Interior data
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://devkansh-interior-app.vercel.app/api/google-callback
GOOGLE_OAUTH_REFRESH_TOKEN=your-refresh-token
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# Server-side admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# Long random secrets (32+ characters)
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
PUBLIC_FILE_SECRET=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_SECRET

# Optional Google Workspace Shared Drive service-account fallback
GOOGLE_CLIENT_EMAIL=your-service-account-email
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n"
